{
  "name": "flowryd-ev-alpha",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "eval": "node --experimental-strip-types scripts/run-evals.ts",
    "supabase:upload-all": "node --experimental-strip-types scripts/upload_flowryd_data.ts",
    "supabase:upload-flowryd": "node --experimental-strip-types scripts/upload_flowryd_data.ts",
    "supabase:embed-vehicles": "node --experimental-strip-types scripts/embed_vehicles.ts",
    "supabase:ingest-trusted-knowledge": "node --experimental-strip-types scripts/ingest_trusted_ev_knowledge.ts",
    "inventory:crawl": "node --experimental-strip-types inventory-scraping/crawl-inventory.ts",
    "inventory:crawl:crawl4ai": "node --experimental-strip-types inventory-scraping/crawl-inventory.ts --fetcher=crawl4ai",
    "inventory:crawl:offline": "node --experimental-strip-types inventory-scraping/crawl-inventory.ts --offline",
    "inventory:crawl4ai:setup": "python3 -m venv inventory-scraping/crawl4ai/.venv && inventory-scraping/crawl4ai/.venv/bin/pip install -r inventory-scraping/crawl4ai/requirements.txt && inventory-scraping/crawl4ai/.venv/bin/crawl4ai-setup",
    "inventory:list-sources": "node --experimental-strip-types inventory-scraping/crawl-inventory.ts --list-sources",
    "supabase:verify-embeddings": "node --experimental-strip-types scripts/verify-embeddings.ts",
    "supabase:upload-willhaben": "node --experimental-strip-types scripts/upload_willhaben_inventory.ts",
    "supabase:upload-autoscout24": "node --experimental-strip-types scripts/upload_autoscout24_inventory.ts",
    "supabase:convert-vehicles-sheet": "node --experimental-strip-types scripts/convert_vehicles_sheet_to_supabase_csv.ts",
    "admin:create": "node --experimental-strip-types scripts/create-admin-user.ts",
    "inspect:ai-context": "node --experimental-strip-types scripts/inspect_ai_context.ts",
    "ci": "npm run typecheck && npm run test && npm run eval && npm run build"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@radix-ui/react-dialog": "^1.1.17",
    "@radix-ui/react-slot": "^1.3.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.107.0",
    "@tailwindcss/postcss": "^4.3.1",
    "cheerio": "^1.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "next": "^15.1.0",
    "next-themes": "^0.4.6",
    "openai": "^6.42.0",
    "postcss": "^8.5.15",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "shadcn": "^4.11.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.1",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.21",
    "@types/react": "^19.0.1",
    "@types/react-dom": "^19.0.1",
    "eslint": "^9.16.0",
    "eslint-config-next": "^15.1.0",
    "typescript": "^5.7.2"
  }
}
